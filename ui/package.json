{
  "name": "hearth-next",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && astro build",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test src/lib/*.test.mjs && vitest run",
    "build:ssr": "vite build -c vite.ssr.config.ts",
    "layout": "node layout/check.mjs && node layout/fill.mjs",
    "test:layout": "npm run build && npm run build:ssr && node layout/check.mjs && node layout/fill.mjs"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.3.5",
    "svelte": "5.57.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "happy-dom": "21.0.4",
    "playwright": "1.65.0",
    "svelte-check": "4.7.6",
    "vitest": "5.0.5"
  }
}
