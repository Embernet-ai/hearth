# The address people type in the browser. https in real life; the scheme decides
# whether session cookies are Secure.
HEARTH_PUBLIC_BASE_URL=https://hearth.example.com
HEARTH_ADDR=:8080
HEARTH_ENV=production

# Object storage: the Garage container beside it.
HEARTH_S3_ENDPOINT=hearth-garage:3900
# Where a browser would reach storage directly. Nothing uses it today, because downloads stream
# through Hearth, but production insists it differs from the line above. Any name will do.
HEARTH_S3_PUBLIC_ENDPOINT=files.example.com
HEARTH_S3_PUBLIC_USE_SSL=false
HEARTH_S3_BUCKET=hearth
HEARTH_S3_REGION=garage
HEARTH_S3_PATH_STYLE=true

# Sign-in with your own provider is optional. Local accounts work without it.
# HEARTH_OIDC_ISSUER=https://idp.example.com/realms/example
# HEARTH_OIDC_CLIENT_ID=hearth
# HEARTH_OIDC_CLIENT_SECRET=
# HEARTH_OIDC_ALLOWED_DOMAINS=example.com
